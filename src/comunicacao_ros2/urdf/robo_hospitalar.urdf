<?xml version="1.0"?>
<robot name="robo_hospitalar">

<!-- base_link: chassi 0.4x0.3x0.15 m (X x Y x Z), origem no centro -->
<link name="base_link">
  <visual>
    <geometry><box size="0.4 0.3 0.15"/></geometry>
    <material name="cinza"><color rgba="0.6 0.6 0.6 1.0"/></material>
  </visual>
  <collision>
    <geometry><box size="0.4 0.3 0.15"/></geometry>
  </collision>
  <inertial>
    <mass value="5.0"/>
    <inertia ixx="0.046875" ixy="0" ixz="0"
             iyy="0.076042" iyz="0" izz="0.104167"/>
  </inertial>
</link>
<!-- roda_esq: cilindro r=0.05 h=0.03m, girado 90° em X (eixo -> Y) -->
<link name="roda_esq">
  <visual>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    <material name="preto"><color rgba="0.1 0.1 0.1 1.0"/></material>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry><cylinder radius="0.05" length="0.03"/></geometry>
  </collision>
  <inertial>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <mass value="0.2"/>
    <inertia ixx="0.00014" ixy="0" ixz="0"
             iyy="0.00014" iyz="0" izz="0.00025"/>
  </inertial>
</link>
<!-- roda_dir: mesma geometria de roda_esq -->
<link name="roda_dir">
  <visual>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    <material name="preto"><color rgba="0.1 0.1 0.1 1.0"/></material>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry><cylinder radius="0.05" length="0.03"/></geometry>
  </collision>
  <inertial>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <mass value="0.2"/>
    <inertia ixx="0.00014" ixy="0" ixz="0"
             iyy="0.00014" iyz="0" izz="0.00025"/>
  </inertial>
</link>
<!-- juntas continuous: rodas giram livres em Y.
     y = +-0.165 (metade da base 0.15 + metade da roda 0.015)
     z = -0.075 (nivel da base do chassi) -->
<joint name="junta_roda_esq" type="continuous">
  <parent link="base_link"/>
  <child link="roda_esq"/>
  <origin xyz="0 0.165 -0.075" rpy="0 0 0"/>
  <axis xyz="0 1 0"/>
</joint>

<joint name="junta_roda_dir" type="continuous">
  <parent link="base_link"/>
  <child link="roda_dir"/>
  <origin xyz="0 -0.165 -0.075" rpy="0 0 0"/>
  <axis xyz="0 1 0"/>
</joint>
<!-- roda_apoio: esfera r=0.03m, funciona como caster -->
<link name="roda_apoio">
  <visual>
    <geometry><sphere radius="0.03"/></geometry>
    <material name="preto"/>
  </visual>
  <collision>
    <geometry><sphere radius="0.03"/></geometry>
  </collision>
  <inertial>
    <mass value="0.05"/>
    <inertia ixx="0.000018" ixy="0" ixz="0"
             iyy="0.000018" iyz="0" izz="0.000018"/>
  </inertial>
</link>
<!-- junta fixed: x=0.2 (borda frontal do chassi),
     z=-0.095 (mais baixa, compensando o raio menor
     da esfera, para manter o chassi nivelado) -->
<joint name="junta_roda_apoio" type="fixed">
  <parent link="base_link"/>
  <child link="roda_apoio"/>
  <origin xyz="0.2 0 -0.095" rpy="0 0 0"/>
</joint>

</robot>